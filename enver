function print_verbs_full {
  # Finds the searched string if it is in the english field even if it's only
  # a part of a word.
  #
  # In opposite to the function "print_full", this function looks only for lines,
  # which are beginning with "to " followed by a word containing the search string.
  local searched="$1"
        grep -iE "^to +([[:alpha:]]-?)*$searched" "$vocabulary"| grep -F --color=always "$searched"
  return $?
}

function print_full {
  # Finds the searched string if it is in the english field even if it's only
  # a part of a word. But it ignores the occurence of the string in the annotations
  # or tags at the end of the english field. Those annotations are written between
  # squared brackets "[anntotation or tag]".

  local searched="$1"
  grep -iE "^[^[$Tab]*$searched" "$vocabulary" | grep -F --color=always "$searched"
  return $?
}

function print_all {
  # Fields are separated by tabs.  First field is English, second German.
  #
  # Finds all records/lines with the searched string in the first field, even
  # if it is a part of a word or part of an annotation beween squared brackets.
  #
  # The second search string contains three tab characters between the pair of
  # quotation marks!
  local searched="$1"
  grep --color=never -iE "^[^$Tab]*$searched[^$Tab]*$Tab" "$vocabulary"
  return "$?"
}


function approximate_search {
# This function uses agrep.
#
# Search levels 2, 4 and 6 are more fault tolerant than search levels 1,
# 3 and 5.
#
# The search level 2 is search level 1 with more error tolerance. Also
# level 4 equals level 3, but it also accepts a greater difference
# between the searched string and the found string than level 3 does. In
# the same way search level 6 is a more error tolerant search with the
# search pattern of search level 5.
#
# Search levels 5 and 6 are a simplification of the search performed by
# levels 3 and 4, respectively, to work around agrep's limitations for
# long search patterns.
#
# Search level 7 accepts that the searched string is not a word, but
# part of a word.
#
# Search level 8 finally tries to handle agreps problem with long search
# patterns by shortening the searched word. This method was very
# successful in many test with some long words. Furthermore level 8
# accepts via agrep a larger mismatch between the searched string and
# the found string than the levels 1, 3 and 5 would accept.

  local searched="$1"
  local search_level
  local match_found=1   # flag for "no match".
  local len
  local max

  echo -e "\nVersuch einer fehlertoleranten Suche startet." > /dev/stderr
  if [ "$(which agrep)" ]; then

    for search_level in 1 2 3 4 5 6 7 8;
    do

      case "$search_level" in
        1)
          agrep -1 "^to $searched[^$Tab]*$Tab" "$vocabulary" | \
          agrep -1 -w "$searched" > /tmp/enver1.tmp
          match_found="$?"
          if [ "$match_found" -eq "0" ]; then   # adds some data sets with greater differences
            mv /tmp/enver1.tmp /tmp/enver0.tmp
            # Reduces amount of added lines and joins found matches with previous search:
            agrep -2 "^to $searched.*\t" "$vocabulary" | uniq -f 1 -w3 >> /tmp/enver0.tmp
            sort /tmp/enver0.tmp | uniq > /tmp/enver1.tmp
            rm /tmp/enver0.tmp
          fi
          ;;
        2)
          agrep -2 "^to $searched[^$Tab]*$Tab" "$vocabulary" | \
          agrep -1 -w "$searched" > /tmp/enver0.tmp
          match_found="$?"
          uniq -f 1 -w9 /tmp/enver0.tmp > /tmp/enver1.tmp
          if [ "$match_found" -eq "0" ]; then   # adds some data sets with greater differences
            mv /tmp/enver1.tmp /tmp/enver0.tmp
            # Reduces amount of added lines and joins found matches with previous search:
            agrep -4 "^to $searched#\t" dictverbs.txt | \
            agrep -2 -w "$searched" | uniq -f 1 -w6 >> /tmp/enver0.tmp
            sort /tmp/enver0.tmp | uniq > /tmp/enver1.tmp
            rm /tmp/enver0.tmp
          fi
          ;;
        3)
          agrep -1 "^[^$Tab]*$searched[^$Tab]*$Tab" "$vocabulary" | \
          agrep -1 -w "$searched" > /tmp/enver1.tmp
          match_found="$?"
          ;;
        4)
          agrep -2 "^[^$Tab]*$searched[^$Tab]*$Tab" "$vocabulary" | \
          agrep -2 -w "$searched" > /tmp/enver1.tmp
          match_found="$?"
          if [ "$match_found" -eq "0" ]; then   # adds some data sets with greater differences
            mv /tmp/enver1.tmp /tmp/enver0.tmp
            # Reduces amount of added lines and joins found matches with previous search:
            agrep -4 "^to $searched.*\t" dictverbs.txt | \
            agrep -2 -w "$searched" | uniq -f 1 -w6 >> /tmp/enver0.tmp
            sort /tmp/enver0.tmp | uniq > /tmp/enver1.tmp
            rm /tmp/enver0.tmp
          fi
          ;;
        5)
          agrep -1 "$searched[^$Tab]*$Tab" "$vocabulary"          | \
          agrep -1 -w "$searched" > /tmp/enver1.tmp
          match_found="$?"
          ;;
        6)
          agrep -2 "$searched[^$Tab]*$Tab" "$vocabulary"          | \
          agrep -2 -w "$searched" > /tmp/enver1.tmp
          match_found="$?"
          if [ "$match_found" -eq "0" ]; then   # adds some data sets with greater differences
            mv /tmp/enver1.tmp /tmp/enver0.tmp
            # Reduces amount of added lines and joins found matches with previous search:
            # agrep -3 "$searched.*\t" dictverbs.txt | \
            # agrep -2 -w "$searched" | uniq -f 1 -w6 >> /tmp/enver0.tmp
            agrep -3 -w "<to >$searched" dictverbs.txt | \
            uniq -f 1 -w6 >> /tmp/enver0.tmp
            sort /tmp/enver0.tmp | uniq > /tmp/enver1.tmp
            rm /tmp/enver0.tmp
          fi
          ;;
        7)
          agrep -1 "$searched[^$Tab]*$Tab" "$vocabulary" > /tmp/enver1.tmp
          match_found="$?"
          ;;
        8)
          len=${#searched}
          # max=$(bc <<< "scale=0; $len / 2")
          max=$(( len / 2 ))
          # echo "\"$searched\" ist $len Zeichen lang."
          # echo "max = $max"
          for i in $(seq 1 $max);
          do
            len=$(( len - 1 ))
            searched="${searched:0:$len}"
            agrep -2 "^[^$Tab]*$searched[^$Tab]*$Tab" "$vocabulary" > /tmp/enver1.tmp
            if [ "$?" -eq 0 ]; then
              # sublevel=".$i"
              match_found=0
              break
            fi
          done
          if [ $match_found -eq 1 ]; then
            echo "Auch die fehlertolerante Suche hat kein ähnliches Wort gefunden."> /dev/stderr
            exit 1
          fi
          ;;
      esac

      if [ $match_found -eq 0 ]; then
        tr "\t" "#" < /tmp/enver1.tmp | column -s"#" -t > /tmp/enver
        if [ "$?" -eq 0 ]; then
            rm /tmp/enver1.tmp
        else
            mv /tmp/enver1.tmp /tmp/enver
        fi
        # echo "approximate search level ${search_level}${sublevel}" > /dev/pts/0
        # echo -e "approximate search level ${search_level}${sublevel}\n" > /dev/stderr
        echo -e "enver says: approximate search level ${search_level}${sublevel}" >> search_log.txt
        display_page_by_page
        exit 0
      fi
    done

  else
    echo "FEHLER: Das Programm \"agrep\" wurde nicht gefunden."
    echo -e "\nFür eine ungefähre, fehlertolerante Suche muss agrep vorhanden sein."
    echo "agrep bekommen Sie, wenn Sie das Paket \"glimpse\" installieren."
  fi
}


function get_all_verbs {
  local inptfile
  local searched="$1"

  # Current Values:
  if test -z "$2"; then
    inptfile="/tmp/enver"
  else
    inptfile="$2"
  fi

  grep -E "^[[:blank:]]*(to )\<$searched\>.*$Tab" "$vocabulary" > /tmp/enver1

  # The following sets very long lines at the end of the search result
  # omitting, tha the long lines do destimeate the columnisation.

  rm -f /tmp/enver /tmp/enver_long
  while read line
  do
    # Das erste Feld jeder Zeile wird in die Variable 'field' geschrieben:
    field="$(sed -E 's:^(.*\t).*$:\1:' <<< "$line")"

    # If the first field is longer than the half terminal window width:
    if [ "${#field}" -gt $(( $(tput cols) / 2 )) ]; then
      sed -E -e 's:$:\n:' -e 's:\t:\n   :' <<< "$line" >> /tmp/enver_long
      continue
    fi
    echo "$line"
  done < /tmp/enver1 | tr "\t" "#" | column -s"#" -t >> /tmp/enver
  if [ -s /tmp/enver_long ]; then
    echo >> /tmp/enver
    cat /tmp/enver_long >> /tmp/enver
    rm /tmp/enver_long
  fi
  rm /tmp/enver1

  if test -s /tmp/enver; then
    cat "$inptfile"
  else
    # 2020-03-21: Sucht nach einigen Ausdruecken mit Hilfsverben,
    # via mkbase.sh wurde dafuer die Datenbasis erweitert.
    #
    # Diese Datensaetze beginnen in der Datendatei von "dict.cc" mit "[you]".
    grep -E "^[[:blank:]]*(|\[you\] )\<$searched\>.*$Tab" "$vocabulary" | tr "\t" "#" | column -s"#" -t > /tmp/enver
    if test -s /tmp/enver; then
      display_page_by_page # sets also quantity_of_lines
    else
      quantity_of_lines=0
      echo "Kein Datensatz, keine Erklärung zu \"$searched\" gefunden." > /dev/stderr
    fi
  fi
  rm -f /tmp/enver
  return $quantity_of_lines
}


function sample_translations {  
  local verb=$1  
  local target_amount="$2"  # How many examples should the output provide?  

  # Filter und zufällige Auswahl relevanter Beispiele  
  get_all_verbs "$verb" | grep -E '[a-z]{3,}$' | shuf | head -n "$target_amount" | awk -v num_samples="$target_amount" '  
{  
  lines[NR] = $0; # Zeilen speichern  
  # Zeile in Wörter aufteilen  
  split($0, words, " ");  
  last_words[NR] = words[length(words)]; # Letztes Wort speichern  
}   
END {  
  # Ausgabe der gesammelten letzten Wörter, mit Kommas dazwischen:  
  for (i = 1; i <= NR; i++) {  
    if (i > 1) {  
      printf ", "; # Komma zwischen den Wörtern  
    }  
    printf "%s", last_words[i]; # Ausgabe des letzten Wortes  
  }  
  printf "\n\n"; # Zeilenumbruch  

  # Ausgabe der ursprünglichen Zeilen  
  for (i = 1; i <= NR; i++) {  
    print lines[i];  
  }  
}'  
}  


function deep_search_cascade {
  # This extended search tries to find data records by a cascade of regular expressions,
  # the cascade will be stopped if one regular expression has found any matching data record.

  local searched="$1"
  echo "Weitergehende Suche auch nach Wortteilen startet." > /dev/stderr

  # sleep .75
  print_verbs_full "$searched"
  if [ "$?" -ne 0 ]; then
    print_full "$searched"
    if [ "$?" -ne 0 ]; then
      echo "Weitergehende Suche ohne Ergebnis." > /dev/stderr
      echo
      # sleep .5
      echo "Suche nach jedem Vorkommen des Such-Strings startet." > /dev/stderr
      print_all "$searched"
      if [ "$?" -ne 0 ]; then
        echo "Die Zeichenkette \"$searched\" kommt im englischen Teil der Datenbasis nicht vor." > /dev/stderr
        approximate_search "$searched"
      fi
    fi
  fi
}

function phrases {
  # As phrases are identified lines which are beginning with an upper case letter or
  # containing "[Redewendung]" or containing "[idiom]".
  #
  # The searched string has to be in the first field, which is the english part.
  local searched="$1"
  grep -e "^[[:blank:]]*[A-Z]" -e "\[Redewendung\]" -e "\[idiom\]" "$vocabulary" | \
  sed "s/\[Redewendung\]//" | grep -iE "^[[:blank:]]*[^$Tab]*\<$searched\>.*$Tab" | \
  grep --color=always -wi "$searched" | tr "\t" "#" | column -s"#" -t
}


function get_amount_of_approximate_matches {

    local searched="$1"
    local quantity

    if [ $(which agrep) ]; then
      quantity=$(agrep -c1 "^[^$Tab]*$searched[^$Tab]*$Tab" "$vocabulary")
      if [ "$quantity" -gt 0 ]; then

        define_numerus $quantity "Datensatz" "Datensätze"
        echo -e "\n\"$script_name -c $searched\" liefert $quantity $object_name. (Suche nach ungefähr übereinstimmenden Wörtern)" > /dev/stderr

      fi
    fi
}


